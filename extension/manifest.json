{
  "manifest_version": 3,
  "name": "Xtend: Social Media Toolkit",
  "short_name": "Xtend",
  "version": "0.1.0",
  "description": "Small tools that social media sites are missing. Today, on X: save videos and GIFs in the best quality, share clean post links.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*"
      ],
      "js": [
        "shared/video-media.js",
        "page/interceptor.js",
        "shared/post-link.js",
        "page/link-cleaner.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*"
      ],
      "js": [
        "shared/video-media.js",
        "content/debug.js",
        "content/selectors.js",
        "content/post.js",
        "content/video-store.js",
        "content/video-resolver.js",
        "content/download.js",
        "content/share-menu.js",
        "content/main.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
