{
  "manifest_version": 3,
  "name": "Xtend: Video Downloader & More",
  "short_name": "Xtend",
  "version": "0.1.0",
  "description": "Save videos and GIFs from your feed in the best available quality, right from the Share menu. More tools to come.",
  "permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*"
      ],
      "js": [
        "shared/video-media.js",
        "page/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*"
      ],
      "js": [
        "shared/video-media.js",
        "content/debug.js",
        "content/selectors.js",
        "content/post.js",
        "content/video-store.js",
        "content/video-resolver.js",
        "content/download.js",
        "content/share-menu.js",
        "content/main.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
